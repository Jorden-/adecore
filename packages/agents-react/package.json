{
    "name": "@adecore/agents-react",
    "version": "0.0.0",
    "description": "React agent chat threads, composers, approvals, provider accounts and usage views.",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./chat": {
            "source": "./src/chat/index.ts",
            "types": "./dist/chat/index.d.ts",
            "default": "./dist/chat/index.js"
        },
        "./chat/ui": {
            "source": "./src/chat/ui/index.ts",
            "types": "./dist/chat/ui/index.d.ts",
            "default": "./dist/chat/ui/index.js"
        },
        "./prompts": {
            "source": "./src/prompts/index.ts",
            "types": "./dist/prompts/index.d.ts",
            "default": "./dist/prompts/index.js"
        },
        "./providers": {
            "source": "./src/providers/index.ts",
            "types": "./dist/providers/index.d.ts",
            "default": "./dist/providers/index.js"
        },
        "./state": {
            "source": "./src/state/index.ts",
            "types": "./dist/state/index.d.ts",
            "default": "./dist/state/index.js"
        },
        "./usage": {
            "source": "./src/usage/index.ts",
            "types": "./dist/usage/index.d.ts",
            "default": "./dist/usage/index.js"
        },
        "./testing": {
            "source": "./src/testing/index.ts",
            "types": "./dist/testing/index.d.ts",
            "default": "./dist/testing/index.js"
        },
        "./locales": {
            "source": "./src/locales.ts",
            "types": "./dist/locales.d.ts",
            "default": "./dist/locales.js"
        },
        "./locales/*.json": {
            "source": "./src/locales/*.json",
            "default": "./dist/locales/*.json"
        },
        "./theme.css": {
            "source": "./src/theme.css",
            "style": "./src/theme.css",
            "default": "./dist/theme.css"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "bun scripts/build.ts",
        "test": "bun --conditions=source test",
        "test:visuals": "bun --config=integration.bunfig.toml --conditions=source test ./src/chat/visual-viewport.integration.test.ts"
    },
    "dependencies": {
        "@adecore/agent-contracts": "workspace:*",
        "@adecore/editor": "workspace:*",
        "@adecore/editor-react": "workspace:*",
        "@adecore/intelligent-ui": "workspace:*",
        "@adecore/merge": "workspace:*",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.13",
        "@lezer/common": "^1.5.2",
        "@lezer/highlight": "^1.2.3",
        "@lezer/markdown": "^1.7.2",
        "@pierre/diffs": "^1.4.3",
        "@tanstack/react-virtual": "^3.14.13",
        "clsx": "^2.1.1",
        "lucide-react": "^1.47.0",
        "mermaid": "^12.2.0",
        "react-markdown": "^10.1.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.4.3",
        "simple-icons": "^16.32.0",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "peerDependencies": {
        "@adecore/ui": "^0.15.0",
        "i18next": "^26.4.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15"
    },
    "devDependencies": {
        "@adecore/ui": "workspace:*",
        "@types/bun": "^1.4.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "i18next": "^26.4.2",
        "linkedom": "^0.18.13",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15",
        "typescript": "^7.0.2"
    },
    "license": "FSL-1.1-MIT",
    "author": "Bas Milius",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/basmilius/adecore.git",
        "directory": "packages/agents-react"
    },
    "bugs": {
        "url": "https://github.com/basmilius/adecore/issues"
    },
    "homepage": "https://adecore.dev/agents-react/",
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/__snapshots__"
    ],
    "sideEffects": [
        "*.css"
    ]
}
