{
  "name": "@adecore/database",
  "version": "0.0.0",
  "description": "Browse, query and edit SQLite and MySQL databases: React views for the page, a host for the backend and a native helper that talks to the server.",
  "license": "FSL-1.1-MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/adecore.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/basmilius/adecore/issues"
  },
  "homepage": "https://adecore.dev/database/",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__",
    "!src/testing/stub.ts",
    "!src/testing/dom"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./host": {
      "source": "./src/host/index.ts",
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:dom": "bun test --preload ./src/testing/dom/preload.ts interaction",
    "helper:build": "cargo build --release --locked --manifest-path helper/Cargo.toml",
    "helper:check": "cargo fmt --manifest-path helper/Cargo.toml --check && cargo clippy --locked --manifest-path helper/Cargo.toml --all-targets -- -D warnings",
    "helper:test": "cargo test --locked --manifest-path helper/Cargo.toml"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0"
  },
  "optionalDependencies": {
    "@adecore/database-darwin-arm64": "0.0.0",
    "@adecore/database-linux-arm64": "0.0.0",
    "@adecore/database-linux-x64": "0.0.0",
    "@adecore/database-win32-x64": "0.0.0"
  },
  "peerDependencies": {
    "@adecore/ui": "^0.14.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@adecore/ui": "workspace:*",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2"
  }
}
