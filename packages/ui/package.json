{
  "name": "@adecore/ui",
  "version": "0.0.0",
  "description": "React components, a theme, formatters and a settings dialog for desktop-grade apps on React 19, Base UI and Tailwind 4.",
  "license": "FSL-1.1-MIT",
  "author": "Bas Milius",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basmilius/adecore.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/basmilius/adecore/issues"
  },
  "homepage": "https://adecore.dev/ui/",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/testing/dedupe.ts",
    "./dist/testing/dedupe.js"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__",
    "!src/file-tree/testing"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "source": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./format": {
      "source": "./src/format/index.ts",
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/dedupe": {
      "source": "./src/testing/dedupe.ts",
      "types": "./dist/testing/dedupe.d.ts",
      "default": "./dist/testing/dedupe.js"
    },
    "./theme.css": {
      "source": "./src/theme.css",
      "style": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/trees": "1.0.0-beta.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "^26.4.2",
    "opentype.js": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2"
  }
}
