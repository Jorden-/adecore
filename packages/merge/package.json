{
    "name": "@adecore/merge",
    "version": "0.0.0",
    "description": "Pure line diffs, three-way merge blocks and conflict resolution.",
    "license": "FSL-1.1-MIT",
    "author": "Bas Milius",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/basmilius/adecore.git",
        "directory": "packages/merge"
    },
    "bugs": {
        "url": "https://github.com/basmilius/adecore/issues"
    },
    "homepage": "https://adecore.dev/merge/",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/__snapshots__",
        "!src/fixtures"
    ],
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test --conditions=source",
        "test:memory": "bun --config=scripts/memory.bunfig.toml test src/diff-memory.integration.test.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/node": "^24.13.6",
        "typescript": "^7.0.2"
    }
}
